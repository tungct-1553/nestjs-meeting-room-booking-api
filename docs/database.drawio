<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="booking-er" name="Database ERD">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="users" value="&lt;b&gt;public.users&lt;/b&gt;&lt;hr/&gt;PK id: uuid&lt;br/&gt;UQ keycloak_sub: text&lt;br/&gt;email: text nullable&lt;br/&gt;display_name: text nullable&lt;br/&gt;profile_token_iat: double precision nullable&lt;br/&gt;created_at, updated_at: timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="rooms" value="&lt;b&gt;public.rooms&lt;/b&gt;&lt;hr/&gt;PK id: uuid&lt;br/&gt;name: text (NFC, preserves case)&lt;br/&gt;UQ rooms_name_key: trim/NFC/lower&lt;br/&gt;capacity: integer (&gt; 0)&lt;br/&gt;description: text nullable&lt;br/&gt;is_active: boolean&lt;br/&gt;created_at, updated_at: timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="bookings" value="&lt;b&gt;public.bookings&lt;/b&gt;&lt;hr/&gt;PK id: uuid&lt;br/&gt;FK room_id → public.rooms.id (RESTRICT)&lt;br/&gt;FK user_id → public.users.id (RESTRICT)&lt;br/&gt;title: text&lt;br/&gt;start_at, end_at: timestamptz&lt;br/&gt;status: confirmed / cancelled&lt;br/&gt;created_at, updated_at: timestamptz&lt;br/&gt;CHECK start_at &amp;lt; end_at&lt;br/&gt;EXCLUDE bookings_no_overlap&lt;br/&gt;Same room + overlapping [start_at, end_at)&lt;br/&gt;WHERE status = 'confirmed'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="340" height="340" as="geometry" />
        </mxCell>
        <mxCell id="u-b" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="users" target="bookings">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-b" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="rooms" target="bookings">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="schema-note" value="&lt;b&gt;Identity boundary&lt;/b&gt;&lt;hr/&gt;users.keycloak_sub: Keycloak sub, UNIQUE&lt;br/&gt;bookings.user_id: UUID public.users.id&lt;br/&gt;Không có FK tới bảng Keycloak.&lt;br/&gt;&lt;br/&gt;Schema keycloak do Keycloak quản lý." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="340" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
